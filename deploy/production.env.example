# Copy this file to .env on the production host and replace every placeholder.
# Never commit the real production .env.

APP_NAME="Everything"
APP_ENV=production
APP_VERSION=1.1.0
# APP_KEY is generated ONCE for this site and is permanent. Every release receives a
# copy of the same shared/.env. Never run key:generate during an upgrade: a new key
# logs everyone out and makes encrypted values unreadable.
APP_KEY=
APP_DEBUG=false
APP_URL=https://imeverything.ir
IET_RELEASE_PROFILE=full

# First-production bootstrap only. The bootstrap command prompts for the password
# when this value is blank. Remove these bootstrap values after the first admin exists.
IET_BOOTSTRAP_SUPERADMIN_USERNAME=MrEveryThing
IET_BOOTSTRAP_SUPERADMIN_EMAIL=admin@example.com
IET_BOOTSTRAP_SUPERADMIN_PASSWORD=
IET_SEED_DEMO_DATA=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=change_me
DB_USERNAME=change_me
DB_PASSWORD=change_me
# Required on shared MySQL/MariaDB hosts whose default engine is MyISAM
# (otherwise: "Specified key was too long; max key length is 1000 bytes").
DB_ENGINE=InnoDB

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Safe baseline for ordinary shared hosting without a persistent queue worker.
# Switch to database only after a worker is configured.
QUEUE_CONNECTION=sync
QUEUE_AFTER_COMMIT=true
QUEUE_FAILED_DRIVER=database-uuids
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90

# The cache table is created by migrations. On the FIRST install, before migrating,
# run: CACHE_STORE=array /usr/local/php-8.4/bin/php artisan optimize:clear
CACHE_STORE=database

# Keep realtime broadcasting disabled unless the host can run Reverb continuously.
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Private media lives in storage/app/private. storage/ must be the persistent
# shared/storage directory (symlinked into every release).
FILESYSTEM_DISK=local

# Shared hosting without proc_open: no malware scanner can run. Uploads are
# SHA-256 verified and recorded as scan_status=unavailable (never "clean").
# Set MEDIA_SCANNER_REQUIRED=true to refuse unscanned media instead.
MEDIA_SCANNER_ENABLED=false
MEDIA_SCANNER_REQUIRED=false

# proc_open is unavailable, so schedule:run executes scheduled Artisan commands
# in its own process. auto detects this; true/false force the behaviour.
IET_SCHEDULE_IN_PROCESS=auto

# Formal publication should use a real mail transport because accounts require
# verified email and invitation/verification mail must leave the server.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=change_me
MAIL_PASSWORD=change_me
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional AI features. Leave the key blank to keep them unavailable.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_AUTHORING_MODEL=gpt-5.6-luna
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT=60
OPENAI_MAX_OUTPUT_TOKENS=1600
