APP_NAME=IET
APP_ENV=local
APP_VERSION=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
IET_RELEASE_PROFILE=full

# Local/testing fresh-start bootstrap identity.
# Change the placeholder email/password in your own .env before or after the first run.
IET_BOOTSTRAP_SUPERADMIN_USERNAME=MrEveryThing
IET_BOOTSTRAP_SUPERADMIN_EMAIL=mreverything@example.test
IET_BOOTSTRAP_SUPERADMIN_PASSWORD=password
IET_SEED_DEMO_DATA=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Set to reverb to enable realtime inbox delivery.
REVERB_APP_ID=iet-local
REVERB_APP_KEY=iet-local-key
REVERB_APP_SECRET=iet-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true
# DB_QUEUE_CONNECTION=mysql
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# MAIL_URL=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# MAIL_EHLO_DOMAIN=
# MAIL_LOG_CHANNEL=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"



# Optional AI assistance / chat (server-side only)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_AUTHORING_MODEL=gpt-5.6-luna
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT=60
OPENAI_MAX_OUTPUT_TOKENS=1600
